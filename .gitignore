# ── 파이썬 ───────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]

# ── 파이프라인 산출물 ────────────────────────────────────────────────────────
# 강의 하나가 수 GB다. 코드만 올리고 산출물은 각자 자기 PC에서 만든다.
output/

# ── 문서 ────────────────────────────────────────────────────────────────────
# 코드만 올린다. 설명 문서는 내부에서 돌려 보는 것이라 저장소에 두지 않는다.
_doc/
docs/
manual/

# 프로젝트별 언어 설정 — 어느 언어를 다루는지도 남기지 않는다
config.local.json

# 확인용으로 찍은 화면
webapp/_probe.png

# ── 재료 (강의 콘텐츠) ───────────────────────────────────────────────────────
재료/

# ── 내려받는 모델·바이너리 ───────────────────────────────────────────────────
# setup_piper.ps1 이 받아 온다 (수십 MB~). 저장소에 넣을 물건이 아니다.
tools/sample/assets/piper/

# webapp/ 은 코드라 올린다 (static/css·js 포함). 제외하지 않는다.

# ── 윈도·에디터 ──────────────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.vscode/
.idea/
